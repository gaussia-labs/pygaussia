# Level 3 (Exploiter) runs. These are versioned deliberately and are NOT regenerable:
# each run is stochastic RL (LoRA policy gradient) on 4xT4 against a live target
# assistant, so re-running produces different categories. The JSONL files are the only
# record of the runs the paper reports.
#   20260729T164442Z-*  the four reported runs (verified hf_router judge, max_steps=8)
#   20260721T*          earlier runs kept as evidence for why the judge was replaced
#                       (they ran with the original self-evaluating LMJudge)
# Four directories per timestamp = the four accelerate ranks of one run, not four runs.
#
# The whitelist is per artifact type on purpose: it versions the run records (~2.3 MB)
# while keeping trained adapters and tokenizer dumps out (a single tokenizer.json is
# 32 MB, and the base tokenizer is redownloadable).
!results/level3_exploiter/
results/level3_exploiter/*
!results/level3_exploiter/*/
results/level3_exploiter/*/*
!results/level3_exploiter/*/config.json
!results/level3_exploiter/*/failure_report.json
!results/level3_exploiter/*/history.jsonl
!results/level3_exploiter/*/roast_dataset.jsonl

# Scenario catalogue lives in Alquimia-ai/roast-me; copy the .example.yaml files locally.
config/plugins.yaml
config/strategies.yaml
